{
  "version": 1,
  "dataReset": null,
  "id": "tasks",
  "title": "Tasks",
  "description": "A board of agent tasks: plan them, start them in threads and follow their progress.",
  "category": "work",
  "services": [
    {
      "view": "service"
    }
  ],
  "actions": [
    {
      "id": "open",
      "title": "Tasks",
      "icon": "columns-3",
      "location": "status.right",
      "popup": {
        "view": "workspace",
        "width": 0.9,
        "height": 0.86,
        "modal": false,
        "placement": "workspace"
      }
    }
  ],
  "provides": {
    "importer": {
      "accepts": [
        "task-snapshot"
      ],
      "view": "import-draft"
    },
    "threadDecorator": {
      "fields": [
        "subtitle",
        "tone"
      ]
    }
  }
}
