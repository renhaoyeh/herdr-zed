{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "paths": {
      "herdr": ["./types/herdr/herdr.d.ts"]
    }
  },
  "include": ["types/herdr/*.d.ts", "components/**/*", "mods/herdr-zed/**/*"],
  "exclude": ["mods/*/components/**", "node_modules"]
}
